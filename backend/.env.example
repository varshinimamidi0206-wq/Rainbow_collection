# Rainbow Collection Backend Environment Configuration
# Copy this to .env and configure values locally or in Render Dashboard

PORT=5000

# MongoDB Connection String (from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/rainbow?retryWrites=true&w=majority

# JWT Secret for signing user sessions
JWT_SECRET=your_strong_jwt_secret_key_here

# Dedicated Admin Credentials (strictly separate from customer Google login)
ADMIN_EMAIL=admin@rainbowcollection.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Google OAuth 2.0 / OpenID Connect Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://rainbow-jewellers-backend.onrender.com/api/auth/google/callback

# Frontend Application URL (for CORS and OAuth redirect handling)
FRONTEND_URL=https://rainbow-collection-4nlg.vercel.app

# Optional Cloudinary Configuration for Image Uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
